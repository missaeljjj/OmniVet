<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniVet.AvaloniaUI.ViewModels"
             x:Class="OmniVet.AvaloniaUI.Views.LoginView"
             x:DataType="vm:LoginViewModel">

  <Grid Background="#5B9F63">
    <Border Background="#FFFFFF"
            CornerRadius="16"
            Width="480"
            Padding="48,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

      <StackPanel Spacing="0">
           <Ellipse Width="90" Height="90" HorizontalAlignment="Center">
              <Ellipse.Fill>
                <ImageBrush Source="avares://OmniVet.AvaloniaUI/Assets/OmniVetLogo.jpeg" Stretch="UniformToFill"/>
              </Ellipse.Fill>
          </Ellipse>
        <TextBlock Text="OmniVet"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#1E3A26"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0"/>

        <TextBlock Text="Sistema de Gestión Veterinaria"
                   FontSize="14"
                   Foreground="#6E8277"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,32"/>

        <TextBlock Text="Usuario"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="#1E3A26"
                   Margin="0,0,0,6"/>

        <TextBox Text="{Binding Username}"
                 PlaceholderText="user123"
                 Background="#F5FAF6"
                 BorderThickness="0"
                 CornerRadius="8"
                 Padding="14,12"
                 Foreground="#1E3A26"
                 FontSize="14"
                 Margin="0,0,0,20"
                 IsEnabled="{Binding !IsBusy}"/>

        <TextBlock Text="Contraseña"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="#1E3A26"
                   Margin="0,0,0,6"/>

        <TextBox Text="{Binding Password}"
                 PasswordChar="*"
                 Background="#F5FAF6"
                 BorderThickness="0"
                 CornerRadius="8"
                 Padding="14,12"
                 Foreground="#1E3A26"
                 FontSize="14"
                 Margin="0,0,0,16"
                 IsEnabled="{Binding !IsBusy}"/>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#C0392B"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage}"
                   Margin="0,0,0,12"/>  
        
        <Button Command="{Binding LoginCommand}"
                Background="#3F7A4C"
                CornerRadius="8"
                Padding="0,14"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center">
          <Grid>
            <TextBlock Text="Iniciar Sesión"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="15"
                       IsVisible="{Binding !IsBusy}"/>
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Width="60"
                         Foreground="White"
                         Background="#3F7A4C"
                         IsVisible="{Binding IsBusy}"/>
          </Grid>
        </Button>

      </StackPanel>
    </Border>
  </Grid>
</UserControl>