<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniVet.AvaloniaUI.ViewModels"
             x:Class="OmniVet.AvaloniaUI.Views.NavigatorView"
             x:DataType="vm:NavigatorViewModel">

<DockPanel>
    <Border DockPanel.Dock="Top" Background="#5B9F63" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
          
          <Ellipse Width="44" Height="44">
            <Ellipse.Fill>
              <ImageBrush Source="avares://OmniVet.AvaloniaUI/Assets/OmniVetLogo.jpeg" Stretch="UniformToFill"/>
            </Ellipse.Fill>
          </Ellipse>

          <TextBlock Text="OmniVet" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" HorizontalAlignment="Center">
          <Button Command="{Binding GoToHome}" Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Inicio" FontWeight="Bold" Foreground="White"/>
          </Button>
          <Button Background="White" Command="{Binding GoToSalesCommand}" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Ventas" FontWeight="Bold" Foreground="#3F7A4C"/>
          </Button>
          <Button Command="{Binding GoToPurchasesCommand}" Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Compras" FontWeight="Bold" Foreground="White"/>
          </Button>
          <Button Command="{Binding GoToAppointmentsCommand}" Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Citas" FontWeight="Bold" Foreground="White"/>
          </Button>
          <Button Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Inventario" FontWeight="Bold" Foreground="White"/>
          </Button>
          <Button Command="{Binding GoToCustomersCommand}" Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Clientes" FontWeight="Bold" Foreground="White"/>
          </Button>
        </StackPanel>

      </Grid>
    </Border>
    <UserControl  Content="{Binding CurrentView}"/>
</DockPanel>
</UserControl>