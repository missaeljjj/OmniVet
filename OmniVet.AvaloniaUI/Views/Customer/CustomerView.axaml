<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmniVetUI.Views.CustomerView">
  <DockPanel Background="#F5FAF6">

    <Border DockPanel.Dock="Top" Background="#5B9F63" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
          <Ellipse Width="44" Height="44" Fill="White"/>
          <TextBlock Text="OmniVet" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" HorizontalAlignment="Center">
          <Border Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Inicio" FontWeight="Bold" Foreground="White"/>
          </Border>
          <Border Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Ventas" FontWeight="Bold" Foreground="White"/>
          </Border>
          <Border Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Compras" FontWeight="Bold" Foreground="White"/>
          </Border>
          <Border Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Citas" FontWeight="Bold" Foreground="White"/>
          </Border>
          <Border Background="#4C8C55" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Inventario" FontWeight="Bold" Foreground="White"/>
          </Border>
          <Border Background="White" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Clientes" FontWeight="Bold" Foreground="#3F7A4C"/>
          </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="2">
          <Ellipse Width="40" Height="40" Fill="#E3ECE5"/>
          <Border Background="#1E3A26" CornerRadius="8" Width="40" Height="40">
            <TextBlock Text="&#8677;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="32,24" Spacing="24">
        <TextBlock Text="Gestión de Clientes" FontSize="28" FontWeight="Bold" Foreground="#1E3A26"/>

        <Grid ColumnDefinitions="*,*,*,*">
          <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0">
            <StackPanel Spacing="10">
              <Border Background="#E3ECE5" CornerRadius="8" Width="40" Height="40">
                <TextBlock Text="#" FontWeight="Bold" Foreground="#3F7A4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Total Clientes" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="245" FontSize="26" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="Registrados" FontSize="12" Foreground="#6E8277"/>
              <Border Background="#3F7A4C" CornerRadius="8" Padding="0,10">
                <TextBlock Text="Añadir Cliente" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="13"/>
              </Border>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="8,0">
            <StackPanel Spacing="10">
              <Border Background="#E3ECE5" CornerRadius="8" Width="40" Height="40">
                <TextBlock Text="+" FontWeight="Bold" Foreground="#3F7A4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Nuevos" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="+12" FontSize="26" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="Este mes" FontSize="12" Foreground="#6E8277"/>
              <Border Background="#3F7A4C" CornerRadius="8" Padding="0,10">
                <TextBlock Text="Ver Nuevos" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="13"/>
              </Border>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="8,0">
            <StackPanel Spacing="10">
              <Border Background="#E3ECE5" CornerRadius="8" Width="40" Height="40">
                <TextBlock Text="M" FontWeight="Bold" Foreground="#3F7A4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Mascotas" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="312" FontSize="26" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="Registradas" FontSize="12" Foreground="#6E8277"/>
              <Border Background="#3F7A4C" CornerRadius="8" Padding="0,10">
                <TextBlock Text="Ver Mascotas" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="13"/>
              </Border>
            </StackPanel>
          </Border>

          <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0">
            <StackPanel Spacing="10">
              <Border Background="#E3ECE5" CornerRadius="8" Width="40" Height="40">
                <TextBlock Text="&#9733;" FontWeight="Bold" Foreground="#3F7A4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Clientes VIP" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="18" FontSize="26" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="Programa de fidelidad" FontSize="12" Foreground="#6E8277"/>
              <Border Background="#3F7A4C" CornerRadius="8" Padding="0,10">
                <TextBlock Text="Ver VIP" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" FontSize="13"/>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Directorio de Clientes" FontSize="20" FontWeight="Bold" Foreground="#1E3A26" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Background="#3F7A4C" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Añadir Cliente" Foreground="White" FontWeight="Bold" FontSize="13"/>
          </Border>
        </Grid>

        <Border Background="White" CornerRadius="12" ClipToBounds="True">
          <StackPanel>
            <Grid Background="#3F7A4C" ColumnDefinitions="2*,2*,2*,*,*,*">
              <TextBlock Grid.Column="0" Text="Nombre" Foreground="White" FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="1" Text="Teléfono" Foreground="White" FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="2" Text="Correo" Foreground="White" FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="3" Text="Mascotas" Foreground="White" FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="4" Text="Última Visita" Foreground="White" FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="Estado" Foreground="White" FontWeight="Bold" Padding="16,12"/>
            </Grid>

            <Grid ColumnDefinitions="2*,2*,2*,*,*,*" Background="White">
              <TextBlock Grid.Column="0" Text="Angela Montenegro" Padding="16,12"/>
              <TextBlock Grid.Column="1" Text="+505 8609 1243" Padding="16,12"/>
              <TextBlock Grid.Column="2" Text="angela.montenegro@gmail.com" Padding="16,12"/>
              <TextBlock Grid.Column="3" Text="1" Padding="16,12"/>
              <TextBlock Grid.Column="4" Text="12/08/2026" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="Normal" Foreground="#3F7A4C" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="2*,2*,2*,*,*,*" Background="#F5FAF6">
              <TextBlock Grid.Column="0" Text="Lena Silver" Padding="16,12"/>
              <TextBlock Grid.Column="1" Text="+505 7876 4356" Padding="16,12"/>
              <TextBlock Grid.Column="2" Text="lena.silver@gmail.com" Padding="16,12"/>
              <TextBlock Grid.Column="3" Text="2" Padding="16,12"/>
              <TextBlock Grid.Column="4" Text="12/08/2026" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="VIP" Foreground="#B08900" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="2*,2*,2*,*,*,*" Background="White">
              <TextBlock Grid.Column="0" Text="Max Hodgins" Padding="16,12"/>
              <TextBlock Grid.Column="1" Text="+505 8890 4568" Padding="16,12"/>
              <TextBlock Grid.Column="2" Text="max.hodgins@gmail.com" Padding="16,12"/>
              <TextBlock Grid.Column="3" Text="1" Padding="16,12"/>
              <TextBlock Grid.Column="4" Text="12/08/2026" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="Normal" Foreground="#3F7A4C" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="2*,2*,2*,*,*,*" Background="#F5FAF6">
              <TextBlock Grid.Column="0" Text="Caroline González" Padding="16,12"/>
              <TextBlock Grid.Column="1" Text="+505 7718 2022" Padding="16,12"/>
              <TextBlock Grid.Column="2" Text="caroline.gonzalez@gmail.com" Padding="16,12"/>
              <TextBlock Grid.Column="3" Text="3" Padding="16,12"/>
              <TextBlock Grid.Column="4" Text="11/08/2026" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="VIP" Foreground="#B08900" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="2*,2*,2*,*,*,*" Background="White">
              <TextBlock Grid.Column="0" Text="Luis Fernández" Padding="16,12"/>
              <TextBlock Grid.Column="1" Text="+505 8245 7896" Padding="16,12"/>
              <TextBlock Grid.Column="2" Text="luis.fernandez@mail.com" Padding="16,12"/>
              <TextBlock Grid.Column="3" Text="1" Padding="16,12"/>
              <TextBlock Grid.Column="4" Text="11/08/2026" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="Normal" Foreground="#3F7A4C" FontWeight="Bold" Padding="16,12"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
