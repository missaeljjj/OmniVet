<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniVet.AvaloniaUI.ViewModels"
             x:Class="OmniVet.AvaloniaUI.Views.AppointmentView"
             x:DataType="vm:AppointmentViewModel">
  <DockPanel Background="#F5FAF6">


    <ScrollViewer>
      <StackPanel Margin="32,24" Spacing="24">
        <TextBlock Text="Agenda de Citas" FontSize="28" FontWeight="Bold" Foreground="#1E3A26"/>

        <Grid ColumnDefinitions="*,*,*,*">
          <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0">
            <StackPanel Spacing="10">
              <Border Background="#E3ECE5" CornerRadius="8" Width="40" Height="40">
                <TextBlock Text="6" FontWeight="Bold" Foreground="#3F7A4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Citas Hoy" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="6" FontSize="26" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="Programadas" FontSize="12" Foreground="#6E8277"/>
              <Button Background="#3F7A4C" CornerRadius="8" Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <TextBlock Text="Agendar Cita" Foreground="White" FontWeight="Bold" FontSize="13"/>
              </Button>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="8,0">
            <StackPanel Spacing="10">
              <Border Background="#E3ECE5" CornerRadius="8" Width="40" Height="40">
                <TextBlock Text="&#10003;" FontWeight="Bold" Foreground="#3F7A4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Confirmadas" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="4" FontSize="26" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="Listas para atender" FontSize="12" Foreground="#6E8277"/>
              <Button Background="#3F7A4C" CornerRadius="8" Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <TextBlock Text="Ver Agenda" Foreground="White" FontWeight="Bold" FontSize="13"/>
              </Button>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="8,0">
            <StackPanel Spacing="10">
              <Border Background="#E3ECE5" CornerRadius="8" Width="40" Height="40">
                <TextBlock Text="?" FontWeight="Bold" Foreground="#3F7A4C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="En Espera" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="2" FontSize="26" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="Por confirmar" FontSize="12" Foreground="#6E8277"/>
              <Button Background="#3F7A4C" CornerRadius="8" Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <TextBlock Text="Recordatorio" Foreground="White" FontWeight="Bold" FontSize="13"/>
              </Button>
            </StackPanel>
          </Border>

          <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0">
            <StackPanel Spacing="10">
              <Border Background="#F9D9D9" CornerRadius="8" Width="40" Height="40">
                <TextBlock Text="&#10005;" FontWeight="Bold" Foreground="#B23A3A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Canceladas" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="1" FontSize="26" FontWeight="Bold" Foreground="#1E3A26"/>
              <TextBlock Text="Esta semana" FontSize="12" Foreground="#6E8277"/>
              <Button Background="#3F7A4C" CornerRadius="8" Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <TextBlock Text="Ver Historial" Foreground="White" FontWeight="Bold" FontSize="13"/>
              </Button>
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Citas Programadas Hoy" FontSize="20" FontWeight="Bold" Foreground="#1E3A26" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Background="#3F7A4C" CornerRadius="8" Padding="18,10">
            <TextBlock Text="Agendar Cita" Foreground="White" FontWeight="Bold" FontSize="13"/>
          </Button>
        </Grid>

        <Border Background="White" CornerRadius="12" ClipToBounds="True">
          <StackPanel>
            <Grid Background="#3F7A4C" ColumnDefinitions="*,2*,2*,2*,2*,*">
              <TextBlock Grid.Column="0" Foreground="Black" Text="Hora"  FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="1" Foreground="Black" Text="Paciente"  FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="2" Foreground="Black" Text="Dueño"  FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="3" Foreground="Black" Text="Motivo"  FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="4" Foreground="Black" Text="Veterinario"  FontWeight="Bold" Padding="16,12"/>
              <TextBlock Grid.Column="5" Foreground="Black" Text="Estado"  FontWeight="Bold" Padding="16,12"/>
            </Grid>

            <Grid ColumnDefinitions="*,2*,2*,2*,2*,*" Background="White">
              <TextBlock Grid.Column="0" Foreground="Black" Text="09:00" Padding="16,12"/>
              <TextBlock Grid.Column="1" Foreground="Black" Text="Rocky (Bulldog)" Padding="16,12"/>
              <TextBlock Grid.Column="2" Foreground="Black" Text="Carlos Ruiz" Padding="16,12"/>
              <TextBlock Grid.Column="3" Foreground="Black" Text="Desparasitación" Padding="16,12"/>
              <TextBlock Grid.Column="4" Foreground="Black" Text="Dra. Rodríguez" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="Confirmada" Foreground="#3F7A4C" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="*,2*,2*,2*,2*,*" Background="#F5FAF6">
              <TextBlock Grid.Column="0" Text="10:30" Padding="16,12"/>
              <TextBlock Grid.Column="1" Text="Lazzy (Rottweiler)" Padding="16,12"/>
              <TextBlock Grid.Column="2" Text="Angela Montenegro" Padding="16,12"/>
              <TextBlock Grid.Column="3" Text="Vacunación Anual" Padding="16,12"/>
              <TextBlock Grid.Column="4" Text="Dr. López" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="En Espera" Foreground="#B08900" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="*,2*,2*,2*,2*,*" Background="White">
              <TextBlock Grid.Column="0" Foreground="Black" Text="11:00" Padding="16,12"/>
              <TextBlock Grid.Column="1" Foreground="Black" Text="Simba (Angora)" Padding="16,12"/>
              <TextBlock Grid.Column="2" Foreground="Black" Text="Lena Silver" Padding="16,12"/>
              <TextBlock Grid.Column="3" Foreground="Black" Text="Chequeo General" Padding="16,12"/>
              <TextBlock Grid.Column="4" Foreground="Black" Text="Dra. Rodríguez" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="En Consulta" Foreground="#2B5FA0" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="*,2*,2*,2*,2*,*" Background="#F5FAF6">
              <TextBlock Grid.Column="0" Foreground="Black" Text="11:30" Padding="16,12"/>
              <TextBlock Grid.Column="1" Foreground="Black" Text="Kira (Golden)" Padding="16,12"/>
              <TextBlock Grid.Column="2" Foreground="Black" Text="Max Hodgins" Padding="16,12"/>
              <TextBlock Grid.Column="3" Foreground="Black" Text="Lesión Pata" Padding="16,12"/>
              <TextBlock Grid.Column="4" Foreground="Black" Text="Dr. Gómez" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="Confirmada" Foreground="#3F7A4C" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="*,2*,2*,2*,2*,*" Background="White">
              <TextBlock Grid.Column="0" Foreground="Black" Text="12:30" Padding="16,12"/>
              <TextBlock Grid.Column="1" Foreground="Black" Text="Tambor (Conejo)" Padding="16,12"/>
              <TextBlock Grid.Column="2" Foreground="Black" Text="Caroline González" Padding="16,12"/>
              <TextBlock Grid.Column="3" Foreground="Black" Text="Control de Peso" Padding="16,12"/>
              <TextBlock Grid.Column="4" Foreground="Black" Text="Dr. López" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="Finalizada" Foreground="#6E8277" FontWeight="Bold" Padding="16,12"/>
            </Grid>
            <Grid ColumnDefinitions="*,2*,2*,2*,2*,*" Background="#F5FAF6">
              <TextBlock Grid.Column="0" Foreground="Black" Text="13:15" Padding="16,12"/>
              <TextBlock Grid.Column="1" Foreground="Black" Text="Coco (Maltés)" Padding="16,12"/>
              <TextBlock Grid.Column="2" Foreground="Black" Text="Luis Fernández" Padding="16,12"/>
              <TextBlock Grid.Column="3" Foreground="Black" Text="Cirugía Menor" Padding="16,12"/>
              <TextBlock Grid.Column="4" Foreground="Black" Text="Dr. Gómez" Padding="16,12"/>
              <TextBlock Grid.Column="5" Text="Cancelada" Foreground="#B23A3A" FontWeight="Bold" Padding="16,12"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>